<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I Love You Nishuu Jii 💖</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    min-height:100vh;
    display:flex; align-items:center; justify-content:center;
    font-family:'Segoe UI', system-ui, sans-serif;
    overflow:hidden;
    background:linear-gradient(-45deg,#ffb3c6,#ffd6e0,#e0c3fc,#c2e9fb);
    background-size:400% 400%;
    animation:bgMove 12s ease infinite;
    position:relative;
    padding:16px;
  }
  @keyframes bgMove {
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
  }
  .hearts { position:fixed; inset:0; pointer-events:none; overflow:hidden; }
  .heart {
    position:absolute; bottom:-40px; font-size:22px;
    animation:floatUp linear infinite; opacity:0.8;
  }
  @keyframes floatUp {
    0% { transform:translateY(0) rotate(0deg) scale(1); opacity:0; }
    10% { opacity:0.9; }
    90% { opacity:0.7; }
    100% { transform:translateY(-110vh) rotate(360deg) scale(1.3); opacity:0; }
  }
  .card {
    position:relative; z-index:10;
    background:rgba(255,255,255,0.6);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border:2px solid rgba(255,255,255,0.85);
    border-radius:28px; padding:34px 24px;
    max-width:380px; width:100%; text-align:center;
    box-shadow:0 20px 50px rgba(255,105,150,0.25);
    animation:popIn 0.8s cubic-bezier(.2,1.4,.4,1);
  }
  @keyframes popIn {
    from { transform:scale(0.6); opacity:0; }
    to { transform:scale(1); opacity:1; }
  }
  .emoji-face {
    font-size:56px; display:inline-block;
    animation:bounce 1.6s ease-in-out infinite;
  }
  @keyframes bounce {
    0%,100% { transform:translateY(0) rotate(-4deg); }
    50% { transform:translateY(-14px) rotate(4deg); }
  }
  h1 {
    font-size:24px; margin:12px 0 4px;
    background:linear-gradient(90deg,#ff4d88,#b84dff,#ff4d88);
    background-size:200% auto;
    -webkit-background-clip:text; background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:shine 3s linear infinite;
  }
  @keyframes shine { to { background-position:200% center; } }
  .name {
    font-size:20px; font-weight:800; color:#9d4edd;
    animation:pulse 2s ease-in-out infinite; display:inline-block;
  }
  @keyframes pulse {
    0%,100% { transform:scale(1); }
    50% { transform:scale(1.08); }
  }
  .msg-box {
    margin:16px 0 10px; min-height:52px;
    display:flex; align-items:center; justify-content:center;
    font-size:21px; font-weight:800; color:#e0397a;
    line-height:1.35; transition:opacity .3s;
    text-shadow:0 2px 10px rgba(255,105,150,0.3);
  }
  .quote-box {
    min-height:56px; margin-bottom:20px;
    display:flex; align-items:center; justify-content:center;
    font-size:14px; font-style:italic; color:#6a4c5a;
    line-height:1.5; padding:0 4px;
    transition:opacity .3s;
  }
  button {
    font-family:inherit; font-size:17px; font-weight:800; color:#fff;
    background:linear-gradient(135deg,#ff6b9d,#c44dff);
    border:none; padding:16px 34px; border-radius:50px; cursor:pointer;
    box-shadow:0 8px 22px rgba(196,77,255,0.4);
    transition:transform .15s;
    animation:btnGlow 2s ease-in-out infinite;
    letter-spacing:0.3px;
  }
  @keyframes btnGlow {
    0%,100% { box-shadow:0 8px 22px rgba(196,77,255,0.4); }
    50% { box-shadow:0 8px 34px rgba(255,107,157,0.75); }
  }
  button:active { transform:scale(0.94); }
  .counter {
    margin-top:14px; font-size:13px; color:#b06a8a; font-weight:600;
  }
  .confetti {
    position:fixed; top:-20px; font-size:18px;
    pointer-events:none; z-index:20;
    animation:fall linear forwards;
  }
  @keyframes fall {
    to { transform:translateY(105vh) rotate(720deg); opacity:0; }
  }
</style>
</head>
<body>
<div class="hearts" id="hearts"></div>

<div class="card">
  <div class="emoji-face" id="face">🥺</div>
  <h1>Hey <span class="name">Nishuu Jii</span> 💖</h1>
  <div class="msg-box" id="msg">Neeche button dabao na... 🥹</div>
  <div class="quote-box" id="quote">Ek click... aur duniya ki sabse pyari baat 💕</div>
  <button id="btn">Start Nishuu Jii 💖</button>
  <div class="counter" id="counter"></div>
</div>

<script>
  /* ====== GF WALE MESSAGES YAHAN ====== */
  const messages = [
    "I love you baby 💖",
    "I love you Nishuu Jii 💕",
    "I love you Mumma 🥰",
    "I love you meri jaan 💗",
    "I love you cutie pie 🌸",
    "I love you princess 👑",
    "I love you soneya ✨",
    "I love you babu 💫",
    "I love you meri zindagi 💝",
    "I love you... bas tumse 💘"
  ];

  /* ====== LOVE QUOTES YAHAN ====== */
  const quotes = [
    "\"Tumhari smile meri sabse pyari cheez hai.\"",
    "\"Tum ho to sab kuch hai, tum na ho to kuch bhi nahi.\"",
    "\"Meri duniya tumse shuru, tum pe khatam.\"",
    "\"Har dua me bas tumhara naam hai.\"",
    "\"Tumse pyar karna meri sabse achi aadat hai.\"",
    "\"Chaand bhi fika hai tumhare saamne.\"",
    "\"Tumhari hansi meri dawa hai.\"",
    "\"Dil kehta hai, sirf tumhara hoon.\"",
    "\"Tumse milke laga, jeena kya hota hai.\"",
    "\"Meri har khushi me tumhara haath hai.\""
  ];

  const faces = ['🥺','😊','😄','🥹','😁','🥰','🤗','💖','😍','💘'];

  let idx = 0;
  const msgEl = document.getElementById('msg');
  const quoteEl = document.getElementById('quote');
  const faceEl = document.getElementById('face');
  const btn = document.getElementById('btn');
  const counterEl = document.getElementById('counter');

  btn.addEventListener('click', () => {
    msgEl.style.opacity = 0;
    quoteEl.style.opacity = 0;

    setTimeout(() => {
      msgEl.textContent = messages[idx];
      quoteEl.textContent = quotes[idx];
      faceEl.textContent = faces[idx];
      msgEl.style.opacity = 1;
      quoteEl.style.opacity = 1;
      counterEl.textContent = `I love you bola ${idx + 1} baar 💕`;

      idx = (idx + 1) % messages.length;

      if (idx === 0) {
        btn.textContent = "Phir se Start Nishuu Jii 💖";
      } else {
        btn.textContent = "Aur Bolo Na 💖";
      }
    }, 250);

    burstConfetti();
  });

  function burstConfetti() {
    const icons = ['💖','✨','🌸','💫','💕','⭐','🎀','💘'];
    for (let i = 0; i < 24; i++) {
      const c = document.createElement('div');
      c.className = 'confetti';
      c.textContent = icons[Math.floor(Math.random()*icons.length)];
      c.style.left = Math.random()*100 + 'vw';
      c.style.fontSize = (12 + Math.random()*14) + 'px';
      c.style.animationDuration = (2 + Math.random()*2) + 's';
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 4200);
    }
  }

  // Background floating hearts
  const emojis = ['💖','💕','🌸','✨','💗','🌷','💫','🦋'];
  const hearts = document.getElementById('hearts');
  for (let i = 0; i < 18; i++) {
    const h = document.createElement('div');
    h.className = 'heart';
    h.textContent = emojis[Math.floor(Math.random()*emojis.length)];
    h.style.left = Math.random()*100 + 'vw';
    h.style.fontSize = (14 + Math.random()*20) + 'px';
    h.style.animationDuration = (6 + Math.random()*8) + 's';
    h.style.animationDelay = (Math.random()*8) + 's';
    hearts.appendChild(h);
  }
</script>
</body>
</html>
